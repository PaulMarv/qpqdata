# Required: choose a unique local password before starting Compose.
POSTGRES_PASSWORD=
POSTGRES_USER=qpqdata
POSTGRES_DB=qpqdata
# URL-encode reserved characters in this password; use the same password as above.
QPQ_DATABASE_URL=postgresql+psycopg://qpqdata:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/qpqdata
# Change this host port if another local PostgreSQL reserves 5432.
POSTGRES_HOST_PORT=5432
# Development harness only; never use these settings for staging or production.
QPQ_ENVIRONMENT=development
QPQ_DEV_EMAIL_ENABLED=true
QPQ_FRONTEND_URL=http://localhost:3000
QPQ_VERIFICATION_TTL_SECONDS=900
# Enable accounts explicitly; application defaults remain disabled.
QPQ_AUTH_ENABLED=true

# Private local image storage (development/test only; production fails closed)
QPQ_UPLOADS_ENABLED=false
QPQ_STORAGE_ROOT=/app/private-images

# Development-only dataset worker and free downloads; explicit publication still required.
QPQ_DATASETS_ENABLED=false
