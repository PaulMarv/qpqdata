QPQ_DATABASE_URL=postgresql+psycopg://qpqdata:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/qpqdata
# Opt in only for local email testing. For host execution, publish a loopback
# Mailpit SMTP port via a local Compose override; default Compose keeps it internal.
QPQ_ENVIRONMENT=development
QPQ_DEV_EMAIL_ENABLED=true
QPQ_FRONTEND_URL=http://localhost:3000
QPQ_SMTP_HOST=localhost
QPQ_SMTP_PORT=1025
QPQ_VERIFICATION_TTL_SECONDS=900
# Local Phase 2A accounts; production defaults are disabled.
QPQ_AUTH_ENABLED=true
QPQ_SESSION_SECONDS=43200
QPQ_SESSION_IDLE_SECONDS=1800

# Private local image storage (development/test only; production fails closed)
QPQ_UPLOADS_ENABLED=false
QPQ_STORAGE_ROOT=/app/private-images
